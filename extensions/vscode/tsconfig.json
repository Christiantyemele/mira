{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "../../",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "types": ["node", "vscode"]
  },
  "include": [
    "src/**/*",
    "../../services/**/*",
    "../../storage/**/*"
  ]
}
